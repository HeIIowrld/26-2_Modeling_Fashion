# 저장소 어디서든 생기는 파이썬 산출물.
# ai_fashion_recommender/.gitignore 는 그 폴더 안에서만 적용되므로
# web/ 처럼 루트 바로 아래 폴더는 여기서 막는다.
__pycache__/
*.py[cod]
.DS_Store
.ipynb_checkpoints/
.pytest_cache/
.venv*/

# Claude Code 로컬 세션 설정
.claude/

# 대용량 원본·외부 저장소는 커밋하지 않는다
/모델링_인스타.zip
/third_party/

# 배포 압축본과 체크섬은 experiments/build_release_zip.py로 재생성한다.
/packages/*.zip
/packages/PACKAGE_CHECKSUMS.json

# 이미지 자산은 재배포 금지 — 코드와 메타데이터(CSV)만 커밋한다
/datasets/people/
/datasets/garments/

# 영상 수집 파이프라인 산출물 (대용량, 재수집 가능) — 코드는 collect/에 커밋한다
/data/
collect/*.log

# 실행 도구 바이너리 (ffmpeg, mediapipe 모델) — setup.py가 내려받는다
collect/tools/

# impeccable(디자인 도구)이 npx install 로 심는 파일들.
# 도구 본체는 저장소에 넣지 않는다 — 각자 `npx impeccable install` 로 받는다.
# 프로젝트 고유 결정이 담긴 PRODUCT.md / DESIGN.md 만 커밋한다.
.claude/skills/
.impeccable/
.github/skills/
.github/agents/impeccable-*
.github/hooks/impeccable.json
